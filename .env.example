# Monolith SEO — variáveis locais (copie para `.env.local` na raiz do Next)
# URL do FastAPI em services/python-api (proxy servidor → servidor)
PYTHON_API_URL=http://127.0.0.1:8000

# URL pública do FastAPI para iframe de preview no browser (mesmo host em dev)
NEXT_PUBLIC_PYTHON_API_URL=http://127.0.0.1:8000